[Unit]
Description=FaceID Hybrid Linux Authentication Socket
Documentation=https://github.com/faceid-auth-desktop
PartOf=faceid-auth.service

[Socket]
ListenStream=/run/faceid/faceid.sock
SocketUser=root
SocketGroup=video
SocketMode=0660
DirectoryMode=0755
RemoveOnStop=true

[Install]
WantedBy=sockets.target
